    <!-- Install guides for agents that are not bundled in this build yet -->
    <string name="guide_coming_soon">This agent\'s runtime is not bundled in this build yet. A guide will be added when it is available.</string>
    <string name="guide_opencode">OpenCode (SST)\n\nInstall the runtime (Termux/proot):\nnpm install -g opencode-ai\n\nGuide: https://opencode.ai/docs\n\nOnce installed, the app will be able to launch it as the active agent.</string>
    <string name="guide_hermes">Hermes (Nous Research)\n\nThe Hermes agent runtime is not available for Android yet. It will be bundled in a future build.\n\nTrack: https://nousresearch.com/hermes</string>
    <string name="guide_claude">Claude Code (Anthropic)\n\nInstall the runtime (Termux/proot):\nnpm install -g @anthropic-ai/claude-code\n\nRequires an Anthropic account and login:\nclaude login\n\nGuide: https://docs.anthropic.com/claude-code</string>
    <string name="guide_gemini">Gemini CLI (Google)\n\nInstall the runtime (Termux/proot):\nnpm install -g @google/gemini-cli\n\nRequires a Google account; login with:\ngemini login\n\nGuide: https://github.com/google-gemini/gemini-cli</string>
    <string name="guide_qwen">Qwen Code (Alibaba)\n\nInstall the runtime (Termux/proot):\npip install -U qwen-code\n\nGuide: https://github.com/QwenLM/qwen-code</string>
    <string name="guide_aider">Aider (Paul Gauthier)\n\nInstall the runtime (Termux/proot):\npython -m pip install -U aider-chat\n\nGuide: https://aider.chat/docs/install.html</string>
    <string name="guide_goose">Goose (Block)\n\nInstall the runtime (Termux/proot):\ncurl -fsSL https://github.com/block/goose/releases/latest/download/install.sh | bash\n\nGuide: https://block.github.io/goose</string>
    <string name="guide_continue">Continue\n\nContinue is a desktop IDE assistant (VS Code / JetBrains), not a terminal agent.\n\nIt cannot run inside this app yet.\n\nGuide: https://docs.continue.dev</string>
